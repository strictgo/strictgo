package fixes

import "strings"

type (
	run     struct{ Value int }
	rebuild struct{ Run run }
	capture struct{ Rebuild *rebuild }
	record  struct {
		Status string
		Stage  string
		Number int
	}
)

func expanded(normal, noVCS *capture, values []int, table map[int]int, result *record) {
	base := normal.Rebuild.Run
	variant := noVCS.Rebuild.Run // want "use separate assignments for multiple value sources"
	left := values[0]
	right := values[1] // want "use separate assignments for multiple value sources"
	before := table[0]
	after := table[1] // want "use separate assignments for multiple value sources"
	first := source()
	second := source() // want "use separate assignments for multiple value sources"
	seen := make(map[string]bool)
	recompiled := make(map[string]bool) // want "use separate assignments for multiple value sources"
	low := -1
	high := 1 + 2 // want "use separate assignments for multiple value sources"
	text := strings.TrimSpace(" text ")
	repeated := strings.Repeat("x", 2) // want "use separate assignments for multiple value sources"
	one := run{Value: 1}
	two := run{Value: 2} // want "use separate assignments for multiple value sources"
	function := func() int { return 1 }
	number := 2 // want "use separate assignments for multiple value sources"
	Run := normal.Rebuild.Run
	alternate := noVCS.Rebuild.Run // want "use separate assignments for multiple value sources"
	result.Status = "failed"
	result.Stage = "cleanup" // want "use separate assignments for multiple value sources"
	result.Number = first
	high = -2 // want "use separate assignments for multiple value sources"
	left = one.Value
	right = two.Value // want "use separate assignments for multiple value sources"
	left = -3
	right = 2 + 3 // want "use separate assignments for multiple value sources"

	// Existing variables can be observed by calls or by panic recovery.
	left, extra := 1, source()                // want "use separate assignments for multiple value sources"
	left, right = 1, values[0]                // want "use separate assignments for multiple value sources"
	left, right = 1, normal.Rebuild.Run.Value // want "use separate assignments for multiple value sources"
	// The pointer may alias the struct read by the second source.
	var copied record
	var other record
	result.Number, other = 1, copied // want "use separate assignments for multiple value sources"
	_ = other
	// Splitting must not bind a later expression to a new local name.
	{
		strings, other := 1, strings.TrimSpace(" text ") // want "use separate assignments for multiple value sources"
		_ = strings
		_ = other
	}
	_ = base
	_ = variant
	_ = left
	_ = right
	_ = before
	_ = after
	_ = first
	_ = second
	_ = seen
	_ = recompiled
	_ = low
	_ = high
	_ = text
	_ = repeated
	_ = one
	_ = two
	_ = function
	_ = number
	_ = Run
	_ = alternate
	_ = extra
}
